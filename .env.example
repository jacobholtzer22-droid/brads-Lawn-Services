# Brad's Lawn Services — Environment Variables
# All NEXT_PUBLIC_ values bake at build time. Changing them requires a cache-free redeploy.

# Site URL (canonical host, with www)
NEXT_PUBLIC_SITE_URL=https://www.bradslawnservices.com

# CRM integration — Align & Acquire contact endpoint
NEXT_PUBLIC_CRM_URL=https://www.alignandacquire.com/api/contact

# Platform business slug — MUST match the exact slug from the Business row in the platform DB
# A wrong slug returns HTTP 200 and silently drops the lead
NEXT_PUBLIC_BUSINESS_SLUG=REPLACE_ME_SLUG

# Google Search Console verification — Jacob adds his own token after setup
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Ads conversion tracking — all no-op when empty
NEXT_PUBLIC_AW_CONVERSION_ID=
NEXT_PUBLIC_AW_FORM_LABEL=
NEXT_PUBLIC_AW_CALL_LABEL=
