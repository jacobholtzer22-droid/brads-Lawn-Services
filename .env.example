# Brad's Lawn Services — Environment Variables
#
# All NEXT_PUBLIC_ values are baked into the bundle at BUILD time.
# Changing any of them requires a cache-free redeploy, not just a restart.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical host, with www. Used for canonicals, sitemap, OG URLs, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.bradslawnservices.com

# ---------------------------------------------------------------------------
# CRM / lead capture
# ---------------------------------------------------------------------------

# Align & Acquire contact endpoint. Must use the www host — the bare apex
# 308-redirects and the cross-origin POST preflight fails against a redirect.
NEXT_PUBLIC_CRM_URL=https://www.alignandacquire.com/api/contact

# Name of the honeypot field the CRM spam check reads.
# Leave unset to use the default ("website"). Set this only if the platform
# expects a different field name. See HANDOFF.md, Gate 3 item (a).
# NEXT_PUBLIC_HONEYPOT_FIELD=website

# Cloudflare Turnstile site key. Leave EMPTY to disable Turnstile entirely:
# no widget renders, no script loads, and no turnstileToken is sent.
# See HANDOFF.md, Gate 3 item (b).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Search Console
# ---------------------------------------------------------------------------

# Jacob's OWN verification token. Do NOT reuse the old site's token — it
# belongs to the previous vendor's account.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Google Ads conversion tracking
# ---------------------------------------------------------------------------
# ALL tracking is a no-op while these are empty: no gtag script is loaded and
# no conversion events fire. Never invent IDs.

# Conversion ID, e.g. AW-XXXXXXXXXX
NEXT_PUBLIC_AW_CONVERSION_ID=

# Conversion label fired on a successful quote-form submit
NEXT_PUBLIC_AW_FORM_LABEL=

# Conversion label fired on any tel: link click
NEXT_PUBLIC_AW_CALL_LABEL=
